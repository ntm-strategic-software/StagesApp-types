{
  "compilerOptions": {
    "module": "commonjs",
    "sourceMap": true, // allows devTools to point back to original line numbers
    "rootDir": "./src",
    "outDir": "./dist",
    "skipLibCheck": true, // true speeds up compilation, avoids flagging errors from node_modules
    "declaration": true, // generates .d.ts files for the project's API
    "declarationMap": true,
  },
  "exclude": [
    "./node_modules",
    "./src/**/*.spec.ts",
    "./dist"
  ]
}
